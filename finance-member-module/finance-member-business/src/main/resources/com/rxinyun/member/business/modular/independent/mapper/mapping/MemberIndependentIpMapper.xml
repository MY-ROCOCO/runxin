<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxinyun.member.business.modular.independent.mapper.MemberIndependentIpMapper">

    <resultMap type="com.rxinyun.member.business.modular.independent.entity.MemberIndependentIp" id="IndependentIpMap">
        <result property="id" column="ID" jdbcType="VARCHAR"/>
        <result property="serverId" column="SERVER_ID" jdbcType="VARCHAR"/>
        <result property="ip" column="IP" jdbcType="VARCHAR"/>
        <result property="mask" column="MASK" jdbcType="VARCHAR"/>
        <result property="gateway" column="GATEWAY" jdbcType="VARCHAR"/>
        <result property="mac" column="MAC" jdbcType="VARCHAR"/>
        <result property="vlanId" column="VLAN_ID" jdbcType="INTEGER"/>
        <result property="cname" column="CNAME" jdbcType="VARCHAR"/>
        <result property="isMain" column="IS_MAIN" jdbcType="INTEGER"/>
        <result property="deleteFlag" column="DELETE_FLAG" jdbcType="VARCHAR"/>
        <result property="createTime" column="CREATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="createUser" column="CREATE_USER" jdbcType="VARCHAR"/>
        <result property="updateTime" column="UPDATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
    </resultMap>

    <delete id="deleteByServerId">
        DELETE FROM business_independent_ip WHERE SERVER_ID = #{serverId}
    </delete>

</mapper>

