<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxinyun.admin.business.modular.esc.mapper.ServerPortMapper">
    <delete id="deletePort">
        DELETE FROM business_server_ports WHERE MASTER_IP = #{masterIp} AND public_port = #{port}
    </delete>

    <select id="checkPortExist" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM business_server_ports WHERE MASTER_IP = #{masterIp} AND public_port = #{port}
    </select>

    <delete id="deleteByServerId">
        DELETE FROM business_server_ports WHERE SERVER_ID = #{serverId}
    </delete>

    <delete id="deleteById">
        DELETE FROM business_server_ports WHERE ID = #{id}
    </delete>
</mapper>
