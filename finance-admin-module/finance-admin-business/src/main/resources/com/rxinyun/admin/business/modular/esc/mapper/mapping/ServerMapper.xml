<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxinyun.admin.business.modular.esc.mapper.ServerMapper">

    <resultMap type="com.rxinyun.admin.business.modular.esc.entity.Server" id="ServerMap">
        <result property="id" column="ID" jdbcType="VARCHAR"/>
        <result property="memberNo" column="MEMBER_NO" jdbcType="VARCHAR"/>
        <result property="masterId" column="MASTER_ID" jdbcType="VARCHAR"/>
        <result property="mfcCloudId" column="MFC_CLOUD_ID" jdbcType="VARCHAR"/>
        <result property="hostName" column="HOST_NAME" jdbcType="VARCHAR"/>
        <result property="lineId" column="LINE_ID" jdbcType="VARCHAR"/>
        <result property="systemClassId" column="OS_CLASS_ID" jdbcType="VARCHAR"/>
        <result property="systemClass" column="OS_CLASS" jdbcType="VARCHAR"/>
        <result property="systemName" column="OS_NAME" jdbcType="VARCHAR"/>
        <result property="systemUserName" column="OS_USER_NAME" jdbcType="VARCHAR"/>
        <result property="port" column="PORT" jdbcType="INTEGER"/>
        <result property="imagePath" column="IMAGE_PATH" jdbcType="VARCHAR"/>
        <result property="imageDirectoryName" column="IMAGE_DIRECTORY_NAME" jdbcType="VARCHAR"/>
        <result property="remark" column="REMARK" jdbcType="VARCHAR"/>
        <result property="serverStatus" column="SERVER_STATUS" jdbcType="VARCHAR"/>
        <result property="businessStatus" column="BUSINESS_STATUS" jdbcType="INTEGER"/>
        <result property="systemPassword" column="OS_PASSWORD" jdbcType="VARCHAR"/>
        <result property="cpu" column="CPU" jdbcType="INTEGER"/>
        <result property="cpuLimit" column="CPU_LIMIT" jdbcType="INTEGER"/>
        <result property="ram" column="RAM" jdbcType="INTEGER"/>
        <result property="bandwidth" column="BANDWIDTH" jdbcType="INTEGER"/>
        <result property="bandwidthIn" column="BANDWIDTH_IN" jdbcType="INTEGER"/>
        <result property="traffic" column="TRAFFIC" jdbcType="INTEGER"/>
        <result property="dataDisks" column="DATA_DISKS" jdbcType="INTEGER"/>
        <result property="publicIp" column="PUBLIC_IP" jdbcType="VARCHAR"/>
        <result property="publicGateway" column="PUBLIC_GATEWAY" jdbcType="VARCHAR"/>
        <result property="publicNetmask" column="PUBLIC_NETMASK" jdbcType="VARCHAR"/>
        <result property="publicMac" column="PUBLIC_MAC" jdbcType="VARCHAR"/>
        <result property="privateIp" column="PRIVATE_IP" jdbcType="VARCHAR"/>
        <result property="privateGateway" column="PRIVATE_GATEWAY" jdbcType="VARCHAR"/>
        <result property="privateNetmask" column="PRIVATE_NETMASK" jdbcType="VARCHAR"/>
        <result property="privateMac" column="PRIVATE_MAC" jdbcType="VARCHAR"/>
        <result property="syncTimeFlag" column="SYNC_TIME_FLAG" jdbcType="INTEGER"/>
        <result property="buyTime" column="BUY_TIME" jdbcType="TIMESTAMP"/>
        <result property="endTime" column="END_TIME" jdbcType="TIMESTAMP"/>
        <result property="systemMaxIops" column="OS_MAX_IOPS" jdbcType="INTEGER"/>
        <result property="dataDisksMaxIops" column="DISKS_MAX_IOPS" jdbcType="INTEGER"/>
        <result property="upstreamServerId" column="UPSTREAM_SERVER_ID" jdbcType="VARCHAR"/>
<!--        <result property="consolePassword" column="CONSOLE_PASSWORD" jdbcType="VARCHAR"/>-->
        <result property="deleteFlag" column="DELETE_FLAG" jdbcType="VARCHAR"/>
        <result property="createTime" column="CREATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="createUser" column="CREATE_USER" jdbcType="VARCHAR"/>
        <result property="updateTime" column="UPDATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="getServersToCheck" resultMap="ServerMap">
        select * from BUSINESS_SERVER
        where BUSINESS_STATUS = 1
          and DELETE_FLAG = 'NOT_DELETE'
          and END_TIME &lt;= #{sevenDaysLater}
    </select>
    <select id="getServersForAutoRenew" resultMap="ServerMap">
        select * from BUSINESS_SERVER
        where BUSINESS_STATUS = 1
          and DELETE_FLAG = 'NOT_DELETE'
          and RENEW_AUTO = 1
          and END_TIME &gt; now()
          and END_TIME &lt;= #{windowEnd}
    </select>
    <select id="getServersToDeleteCheck" resultMap="ServerMap">
        select * from BUSINESS_SERVER
        where BUSINESS_STATUS = -1
          and DELETE_FLAG = 'NOT_DELETE'
          and DELETE_TIME &lt;= now()
    </select>

    <update id="updateServerStatus">
        update BUSINESS_SERVER
        set BUSINESS_STATUS = -1
        where ID = #{id} and BUSINESS_STATUS = 1 and DELETE_FLAG = 'NOT_DELETE'
    </update>

</mapper>

