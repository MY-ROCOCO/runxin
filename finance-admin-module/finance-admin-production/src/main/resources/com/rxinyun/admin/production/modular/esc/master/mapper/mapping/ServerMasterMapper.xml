<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxinyun.admin.production.modular.esc.master.mapper.ServerMasterMapper">

    <resultMap type="com.rxinyun.admin.production.modular.esc.master.entity.ServerMaster" id="ServerMasterMap">
        <result property="id" column="ID" jdbcType="INTEGER"/>
        <result property="lineName" column="lineNames" jdbcType="VARCHAR"/>
        <result property="lineNames" column="lineNames" jdbcType="VARCHAR"/>
        <result property="masterName" column="MASTER_NAME" jdbcType="VARCHAR"/>
        <result property="guardVersion" column="GUARD_VERSION" jdbcType="VARCHAR"/>
        <result property="localIp" column="LOCAL_IP" jdbcType="VARCHAR"/>
        <result property="gatewayIp" column="GATEWAY_IP" jdbcType="VARCHAR"/>
        <result property="switchType" column="SWITCH_TYPE" jdbcType="VARCHAR"/>
        <result property="ip" column="IP" jdbcType="VARCHAR"/>
        <result property="apiPort" column="API_PORT" jdbcType="INTEGER"/>
        <result property="apiPassword" column="API_PASSWORD" jdbcType="VARCHAR"/>
        <result property="status" column="STATUS" jdbcType="INTEGER"/>
        <result property="sortId" column="SORT_ID" jdbcType="INTEGER"/>
        <result property="instanceCount" column="INSTANCE_COUNT" jdbcType="INTEGER"/>
        <result property="publicIpCount" column="PUBLIC_IP_COUNT" jdbcType="INTEGER"/>
        <result property="ramRemaining" column="RAM_REMAINING" jdbcType="INTEGER"/>
        <result property="diskRemaining" column="DISK_REMAINING" jdbcType="BIGINT"/>
        <result property="remarks" column="REMARKS" jdbcType="VARCHAR"/>
        <result property="storeType" column="STORE_TYPE" jdbcType="VARCHAR"/>
        <result property="storeId" column="STORE_ID" jdbcType="VARCHAR"/>
        <result property="rootPort" column="ROOT_PORT" jdbcType="INTEGER"/>
        <result property="rootPassword" column="ROOT_PASSWORD" jdbcType="VARCHAR"/>
        <result property="osPath" column="OS_PATH" jdbcType="VARCHAR"/>
        <result property="osMaxiops" column="OS_MAXIOPS" jdbcType="INTEGER"/>
        <result property="disksPath" column="DISKS_PATH" jdbcType="VARCHAR"/>
        <result property="disksMaxiops" column="DISKS_MAXIOPS" jdbcType="INTEGER"/>
        <result property="cpuLimit" column="CPU_LIMIT" jdbcType="INTEGER"/>
        <result property="ramSize" column="RAM_SIZE" jdbcType="INTEGER"/>
        <result property="ramLimit" column="RAM_LIMIT" jdbcType="INTEGER"/>
        <result property="harddiskSize" column="HARDDISK_SIZE" jdbcType="INTEGER"/>
        <result property="harddiskLimit" column="HARDDISK_LIMIT" jdbcType="INTEGER"/>
        <result property="hvStoreType" column="HV_STORE_TYPE" jdbcType="VARCHAR"/>
        <result property="hvStoreId" column="HV_STORE_ID" jdbcType="VARCHAR"/>
        <result property="nodeName" column="NODE_NAME" jdbcType="VARCHAR"/>
        <result property="memoryDynamic" column="MEMORY_DYNAMIC" jdbcType="INTEGER"/>
        <result property="ramStart" column="RAM_START" jdbcType="INTEGER"/>
        <result property="vncUrl" column="VNC_URL" jdbcType="VARCHAR"/>
        <result property="password" column="PASSWORD" jdbcType="VARCHAR"/>
        <result property="publicSwitchName" column="PUBLIC_SWITCH_NAME" jdbcType="VARCHAR"/>
        <result property="privateSwitchName" column="PRIVATE_SWITCH_NAME" jdbcType="VARCHAR"/>
        <result property="mirrorPath" column="MIRROR_PATH" jdbcType="VARCHAR"/>
        <result property="backupPath" column="BACKUP_PATH" jdbcType="VARCHAR"/>
        <result property="taskConcurrency" column="TASK_CONCURRENCY" jdbcType="INTEGER"/>
        <result property="deleteFlag" column="DELETE_FLAG" jdbcType="VARCHAR"/>
        <result property="createTime" column="CREATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="createUser" column="CREATE_USER" jdbcType="VARCHAR"/>
        <result property="updateTime" column="UPDATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="selectPage" resultMap="ServerMasterMap">
        SELECT sm.*,
               (
                   SELECT GROUP_CONCAT(sll.line_name ORDER BY sll.sort_id SEPARATOR ',')
                   FROM server_master_line sml
                            LEFT JOIN server_local_line sll ON sml.line_id = sll.id
                       AND sll.delete_flag = 'NOT_DELETE'
                   WHERE sml.master_id = sm.id
                     AND sml.delete_flag = 'NOT_DELETE'
               ) AS lineNames,
               (SELECT COUNT(1)
                FROM public_network pn
                WHERE pn.master_id = sm.id
                  AND pn.delete_flag = 'NOT_DELETE') AS PUBLIC_IP_COUNT
        FROM server_master sm
        <where>
            sm.DELETE_FLAG = 'NOT_DELETE'
            <if test="pageParam.lineId != null and pageParam.lineId != ''">
                AND (
                    EXISTS (
                        SELECT 1
                        FROM server_master_line sml_filter
                        WHERE sml_filter.master_id = sm.id
                          AND sml_filter.line_id = #{pageParam.lineId}
                          AND sml_filter.delete_flag = 'NOT_DELETE'
                    )
                )
            </if>
            <if test="pageParam.masterName != null and pageParam.masterName != ''">
                AND sm.master_name LIKE CONCAT('%', #{pageParam.masterName}, '%')
            </if>
            <if test="pageParam.status != null">
                AND sm.status = #{pageParam.status}
            </if>
            <if test="pageParam.searchKey != null and pageParam.searchKey != ''">
                AND sm.master_name LIKE CONCAT('%', #{pageParam.searchKey}, '%')
            </if>
        </where>
        <if test="pageParam.sortField != null and pageParam.sortOrder != null">
            ORDER BY ${pageParam.sortField} ${pageParam.sortOrder}
        </if>
        <if test="pageParam.sortField == null or pageParam.sortOrder == null">
            ORDER BY sm.create_time DESC
        </if>
    </select>

</mapper>

