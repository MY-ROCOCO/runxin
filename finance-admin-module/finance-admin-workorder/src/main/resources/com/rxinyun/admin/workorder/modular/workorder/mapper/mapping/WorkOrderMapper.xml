<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxinyun.admin.workorder.modular.workorder.mapper.WorkOrderMapper">


    <resultMap type="com.rxinyun.admin.workorder.modular.workorder.entity.WorkOrder" id="WorkOrderMap">
        <result property="adminId" column="ADMIN_ID" jdbcType="VARCHAR"/>
        <result property="clientId" column="CLIENT_ID" jdbcType="BIGINT"/>
        <result property="id" column="ID" jdbcType="VARCHAR"/>
        <result property="title" column="TITLE" jdbcType="VARCHAR"/>
        <result property="statusReply" column="STATUS_REPLy" jdbcType="VARCHAR"/>
        <result property="statusOut" column="STATUS_OUT" jdbcType="INTEGER"/>
        <result property="orderCreateTime" column="ORDER_CREATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="orderEndTime" column="ORDER_END_TIME" jdbcType="TIMESTAMP"/>
        <result property="orderAnswerTime" column="ORDER_ANSWER_TIME" jdbcType="TIMESTAMP"/>
        <result property="content" column="CONTENT" jdbcType="VARCHAR"/>
        <result property="productName" column="PRODUCT_NAME" jdbcType="VARCHAR"/>
        <result property="productIp" column="PRODUCT_IP" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectByTypeId" resultType="com.rxinyun.admin.workorder.modular.workorder.entity.WorkOrder">
            select * from work_order where type_id = #{typeId}
    </select>

</mapper>