<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.rxinyun</groupId>
        <artifactId>finance-admin-module</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>finance-admin-dev</artifactId>
    <packaging>jar</packaging>
    <description>开发工具插件</description>

    <dependencies>
        <!-- 每个插件都要引入自己的对外接口 -->
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-dev-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-client-api</artifactId>
        </dependency>

        <!-- 引入登录鉴权接口，用于获取登录用户 -->
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-auth-api</artifactId>
        </dependency>

        <!-- 引入系统接口，用于获取用户等功能 -->
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-sys-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-business-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-order-api</artifactId>
        </dependency>

        <!-- 引入生产管理API，用于访问线路和系统版本信息 -->
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-production-api</artifactId>
        </dependency>

        <!-- 引入业务模块，用于访问ServerService和IndependentService -->
        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-admin-business</artifactId>
        </dependency>

        <dependency>
            <groupId>com.rxinyun</groupId>
            <artifactId>finance-plugin-payments-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.15.2</version> <!-- 使用你项目中对应的版本 -->
        </dependency>

    </dependencies>
</project>
